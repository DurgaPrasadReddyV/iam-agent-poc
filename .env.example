# ---- LLM (only UNDERSTAND_INTENT and GENERATE_PLAN use it) ----
LLM_PROVIDER=mock                  # openai | azure_openai | anthropic | local | mock
LLM_MODEL_INTENT=
LLM_MODEL_PLAN=
LLM_API_KEY=                       # dev only, never commit a real key
LLM_BASE_URL=                      # azure / local OpenAI-compatible endpoint
LLM_CASSETTE_DIR=tests/end-to-end/cassettes

# ---- Security ----
GRANT_SIGNING_KEY=dev-only-change-me
STRICT_GRANTS=true

# ---- Time and data ----
DATA_DIR=./data
SEED_NOW=2026-06-01T00:00:00Z
SEED_PROFILE=default               # default | acceptance

# ---- MCP endpoints (docker compose overrides the host names) ----
KNOWLEDGE_MCP_URL=http://localhost:8101/mcp
MEMORY_MCP_URL=http://localhost:8102/mcp
POLICY_MCP_URL=http://localhost:8103/mcp
AD_MCP_URL=http://localhost:8111/mcp
SQL_MCP_URL=http://localhost:8112/mcp
LINUX_MCP_URL=http://localhost:8113/mcp
APP_MCP_URL=http://localhost:8114/mcp
APPROVAL_MCP_URL=http://localhost:8121/mcp
AUDIT_MCP_URL=http://localhost:8122/mcp
NOTIFICATION_MCP_URL=http://localhost:8123/mcp

# ---- Workflow ----
APPROVAL_TTL_HOURS=72
MAX_PLAN_ACTIONS=25
LOG_LEVEL=INFO
